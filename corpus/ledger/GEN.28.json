  "entity:person.mahalath": {
   "status": "approved",
   "produced_by": {
    "model": "claude-sonnet-5-5",
    "skill": "urim-ontologist@1",
    "run": "main"
   },
   "produced_at": "2026-11-02T13:58:33+00:00",
   "agent_notes": [
    "Mahalath (28:9) is Ishmael's daughter and Nebaioth's sister. Gen 36:3 calls the same woman Basemath, while Gen 26:34 gives the name Basemath to a Hittite wife (corpus: person.adah, daughter of Elon). I kept Mahalath as a separate entity with the registry id; the Basemath tangle is the text's own."
   ],
   "history": [
    {
     "status": "approved",
     "at": "2026-11-02T14:00:42+00:00",
     "note": null,
     "by": "urim-critic@3 · claude-opus-5-5"
    }
   ],
   "source": null
  },
